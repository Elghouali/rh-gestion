          "409": {
            "description": "Conflit : référence dupliquée, version, dépassement ou commande clôturée",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PurchaseInput" }
            }
          }
        }
      }
    },
    "/purchases/{id}": {
      "get": {
        "summary": "OWNER/STOCK_MANAGER : détail limité au site de réception",
        "operationId": "get_purchases_id_",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Purchase" }
              }
            }
          },
          "401": { "description": "Session/JWT manquant ou invalide" },
          "403": { "description": "Rôle ou site interdit" },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        }
      }
    },
    "/purchases/{id}/receipts": {
      "post": {
        "summary": "OWNER/STOCK_MANAGER affecté : réception physique en QUARANTINE",
        "operationId": "post_purchases_id_receipts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,100}$" }
          }
        ],
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Delivery" }
              }
            }
          },
          "400": {
            "description": "Validation, doublon de ligne, quantité fractionnaire",
