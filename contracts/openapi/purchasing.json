  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Supplier": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 160 },
          "phone": { "type": "string", "maxLength": 40 },
          "active": { "type": "boolean" },
          "version": { "type": "integer", "minimum": 0 }
        },
        "required": ["id", "name", "phone", "active", "version"]
      },
      "SupplierInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "phone": { "type": "string", "maxLength": 40 }
        },
        "required": ["name", "phone"]
      },
      "SupplierUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "phone": { "type": "string", "maxLength": 40 },
          "active": { "type": "boolean" },
          "version": { "type": "integer", "minimum": 0 }
        },
        "required": ["name", "phone", "active", "version"]
      },
      "PurchaseItem": {
        "type": "object",
        "properties": {
          "variantId": { "type": "string", "format": "uuid" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "unitCost": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.0001,
            "maximum": 9999999999.9999
          }
        },
        "required": ["variantId", "quantity", "unitCost"]
      },
      "PurchaseInput": {
        "type": "object",
        "properties": {
          "supplierId": { "type": "string", "format": "uuid" },
          "branchId": { "type": "string", "format": "uuid" },
          "reference": { "type": "string", "minLength": 1, "maxLength": 100 },
          "note": { "type": "string", "minLength": 1, "maxLength": 500 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PurchaseItem" },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": ["supplierId", "branchId", "reference", "note", "items"]
      },
      "PurchaseLine": {
        "type": "object",
        "properties": {
          "variantId": { "type": "string", "format": "uuid" },
          "sku": { "type": "string" },
          "label": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 },
          "received": { "type": "integer", "minimum": 0 },
          "remaining": { "type": "integer", "minimum": 0 },
          "unitCost": { "type": "number", "minimum": 0 }
        },
        "required": [
          "variantId",
          "sku",
          "label",
          "quantity",
          "received",
          "remaining"
        ],
        "description": "unitCost présent pour OWNER uniquement, omis pour STOCK_MANAGER. Coût convenu au moment de la commande, figé ; pas de dette comptabilisée."
      },
      "DeliveryLine": {
        "type": "object",
        "properties": {
          "variantId": { "type": "string", "format": "uuid" },
          "sku": { "type": "string" },
          "label": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "integer", "minimum": 0 },
          "rejected": { "type": "integer", "minimum": 0 },
          "pending": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "variantId",
          "sku",
          "label",
          "quantity",
          "accepted",
          "rejected",
          "pending"
        ]
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "reference": { "type": "string" },
          "reason": { "type": "string" },
          "actor": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DeliveryLine" }
          }
        },
        "required": ["id", "reference", "reason", "actor", "createdAt", "items"]
      },
      "Purchase": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "supplierId": { "type": "string", "format": "uuid" },
          "supplierName": { "type": "string" },
          "branchId": { "type": "string", "format": "uuid" },
          "branchName": { "type": "string" },
          "reference": { "type": "string" },
          "note": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["OPEN", "PARTIAL", "RECEIVED", "CLOSED"]
          },
          "version": { "type": "integer", "minimum": 0 },
          "createdAt": { "type": "string", "format": "date-time" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PurchaseLine" }
          },
          "receipts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Delivery" }
          }
        },
        "required": [
          "id",
          "supplierId",
          "supplierName",
          "branchId",
          "branchName",
          "reference",
          "note",
          "status",
          "version",
          "createdAt",
          "items",
          "receipts"
        ]
      },
      "ReceiptItem": {
        "type": "object",
        "properties": {
          "variantId": { "type": "string", "format": "uuid" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        },
        "required": ["variantId", "quantity"]
      },
      "ReceiptInput": {
        "type": "object",
        "properties": {
          "reference": { "type": "string", "minLength": 1, "maxLength": 100 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReceiptItem" },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": ["reference", "reason", "items"]
      },
      "InspectionItem": {
        "type": "object",
        "properties": {
          "variantId": { "type": "string", "format": "uuid" },
          "accepted": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "rejected": { "type": "integer", "minimum": 0, "maximum": 1000000 }
        },
        "required": ["variantId", "accepted", "rejected"]
      },
      "InspectionInput": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InspectionItem" },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": ["reason", "items"],
        "description": "Quantités entières : somme >0 pour chaque ligne et <= pending de cette réception. Validation OWNER, jamais disponible avant contrôle."
      },
      "CloseInput": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "required": ["reason"]
      },
      "Error": {
        "type": "object",
        "properties": { "code": { "type": "string" } },
        "required": []
      },
      "PurchasePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Purchase" }
          },
          "page": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0 }
        },
        "required": ["items", "page", "size", "total"]
      },
      "SupplierPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Supplier" }
          },
          "page": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0 }
        },
        "required": ["items", "page", "size", "total"]
      }
    }
  }
}
