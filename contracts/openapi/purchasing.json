              }
            }
          },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReceiptInput" }
            }
          }
        }
      }
    },
    "/purchases/{id}/receipts/{receiptId}/inspections": {
      "post": {
        "summary": "OWNER : QUARANTINE vers SELLABLE accepté ou REJECTED refusé",
        "operationId": "post_purchases_id_receipts_receiptId_inspections",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "receiptId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,100}$" }
          }
        ],
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Delivery" }
              }
            }
          },
          "400": {
            "description": "Validation, doublon de ligne, quantité fractionnaire",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "description": "Session/JWT manquant ou invalide" },
          "403": { "description": "Rôle ou site interdit" },
          "409": {
            "description": "Conflit : référence dupliquée, version, dépassement ou commande clôturée",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InspectionInput" }
            }
          }
        }
      }
    },
    "/purchases/{id}/close": {
      "post": {
        "summary": "OWNER : clôturer le non reçu ; contrôles du reçu toujours possibles",
        "operationId": "post_purchases_id_close",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,100}$" }
          }
        ],
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Purchase" }
              }
            }
          },
          "400": {
            "description": "Validation, doublon de ligne, quantité fractionnaire",
            "content": {
              "application/problem+json": {
