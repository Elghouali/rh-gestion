{
  "openapi": "3.1.0",
  "info": {
    "title": "RH Suppliers and Purchasing",
    "version": "0.3.0",
    "description": "Finance possède les fournisseurs, Inventory les achats/réceptions. UUID sans FK entre bases. Authentification navigateur par BFF HttpOnly/CSRF, JWT entre services. Toutes les écritures sont idempotentes et journalisées localement. CLOSED porte sur le reliquat non reçu. RECEIVED décrit la réception physique, pas une approbation qualité. Refus isolés dans REJECTED : retour/remplacement fournisseur reste à développer. Pas de facture, dette, paiement ou fiscalité dans ce contrat."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/suppliers": {
      "get": {
        "summary": "OWNER : rechercher les fournisseurs",
        "operationId": "get_suppliers",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string", "maxLength": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierPage" }
              }
            }
          },
          "401": { "description": "Session/JWT manquant ou invalide" },
          "403": { "description": "Rôle ou site interdit" },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        }
      },
      "post": {
        "summary": "OWNER : créer une identité fournisseur",
        "operationId": "post_suppliers",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,100}$" }
          }
        ],
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Supplier" }
              }
            }
          },
          "400": {
            "description": "Validation, doublon de ligne, quantité fractionnaire",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "description": "Session/JWT manquant ou invalide" },
          "403": { "description": "Rôle ou site interdit" },
          "409": {
            "description": "Conflit : référence dupliquée, version, dépassement ou commande clôturée",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SupplierInput" }
            }
          }
        }
      }
    },
    "/suppliers/{id}": {
      "get": {
        "summary": "OWNER : lire un fournisseur",
        "operationId": "get_suppliers_id_",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Supplier" }
              }
            }
          },
          "401": { "description": "Session/JWT manquant ou invalide" },
          "403": { "description": "Rôle ou site interdit" },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        }
      },
      "put": {
        "summary": "OWNER : modifier/archiver avec version",
        "operationId": "put_suppliers_id_",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,100}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Supplier" }
              }
            }
          },
          "400": {
            "description": "Validation, doublon de ligne, quantité fractionnaire",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "description": "Session/JWT manquant ou invalide" },
          "403": { "description": "Rôle ou site interdit" },
          "409": {
            "description": "Conflit : référence dupliquée, version, dépassement ou commande clôturée",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": { "description": "Dépendance indisponible, refus par défaut" }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SupplierUpdate" }
            }
          }
        }
      }
    },
